        {
          "name": "Crear Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonResponse = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 200ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(900);",
                  "});",
                  "",
                  "pm.test(\"User ID is not null\", function () {",
                  "    pm.expect(jsonResponse.id).to.not.be.null;",
                  "    postman.setEnvironmentVariable('idUsuario', jsonResponse.id);",
                  "});",
                  "",
                  "pm.test(\"User has all required fields\", function () {",
                  "    pm.expect(jsonResponse).to.have.property(\"id\");",
                  "    pm.expect(jsonResponse).to.have.property(\"name\");",
                  "    pm.expect(jsonResponse).to.have.property(\"email\");",
                  "    pm.expect(jsonResponse).to.have.property(\"gender\");",
                  "    pm.expect(jsonResponse).to.have.property(\"status\");",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
